.menu-root {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgb(28, 23, 18);
  align-items: center;
  justify-content: center;
}

.menu-title {
  font-size: 96px;
  color: rgb(235, 220, 190);
  -unity-font-style: bold;
  margin-bottom: 48px;
}

.setup-panel {
  width: 560px;
}

.setup-title {
  font-size: 32px;
  color: rgb(235, 220, 190);
  -unity-font-style: bold;
  -unity-text-align: middle-center;
  margin-bottom: 12px;
}

.setup-field {
  margin: 6px 0;
  font-size: 20px;
}

.setup-field Label {
  color: rgb(235, 220, 190);
  min-width: 260px;
}

.setup-info {
  font-size: 16px;
  color: rgb(180, 165, 140);
  margin: 0 0 6px 266px;
}

.setup-buttons {
  flex-direction: row;
  justify-content: space-between;
  margin-top: 16px;
}

.setup-button {
  width: 48%;
}

.hidden {
  display: none;
}
