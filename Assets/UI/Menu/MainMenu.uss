.menu-root {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgb(28, 23, 18);
  align-items: center;
  justify-content: center;
}

.menu-title {
  font-size: 96px;
  color: rgb(235, 220, 190);
  -unity-font-style: bold;
  margin-bottom: 48px;
}

.menu-panel {
  background-color: rgba(20, 16, 12, 0.75);
  border-width: 1px;
  border-color: rgb(150, 120, 70);
  padding: 16px 24px;
  width: 360px;
}

.menu-button {
  height: 52px;
  margin: 6px 0;
  font-size: 24px;
  color: rgb(235, 220, 190);
  background-color: rgb(45, 36, 27);
  border-width: 1px;
  border-color: rgb(150, 120, 70);
}

.menu-button:hover {
  background-color: rgb(70, 56, 40);
}

.menu-button:disabled {
  color: rgb(120, 110, 95);
}
