.menu-root {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgb(28, 23, 18);
  align-items: center;
  justify-content: center;
}

.menu-title {
  font-size: 96px;
  color: rgb(235, 220, 190);
  -unity-font-style: bold;
  margin-bottom: 48px;
}

.setup-info {
  font-size: 16px;
  color: rgb(180, 165, 140);
  margin: 0 0 6px 266px;
}

.hidden {
  display: none;
}
