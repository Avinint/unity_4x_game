/* Titre du jeu (menu principal, écran de chargement). */
.menu-title {
  font-size: 96px;
  color: rgb(235, 220, 190);
  -unity-font-style: bold;
  margin-bottom: 48px;
}

.menu-panel {
  background-color: rgba(20, 16, 12, 0.75);
  border-width: 1px;
  border-color: rgb(150, 120, 70);
  padding: 16px 24px;
  width: 360px;
}

.menu-button {
  height: 52px;
  margin: 6px 0;
  font-size: 24px;
  color: rgb(235, 220, 190);
  background-color: rgb(45, 36, 27);
  border-width: 1px;
  border-color: rgb(150, 120, 70);
}

.menu-button:hover {
  background-color: rgb(70, 56, 40);
}

.menu-button:disabled {
  color: rgb(120, 110, 95);
}

/* Écrans à champs (paramètres de partie, options), partagés par les deux menus. */
.setup-panel {
  width: 560px;
}

.setup-title {
  font-size: 32px;
  color: rgb(235, 220, 190);
  -unity-font-style: bold;
  -unity-text-align: middle-center;
  margin-bottom: 12px;
}

.setup-field {
  margin: 6px 0;
  font-size: 20px;
}

.setup-field Label {
  color: rgb(235, 220, 190);
  min-width: 260px;
}

.setup-buttons {
  flex-direction: row;
  justify-content: space-between;
  margin-top: 16px;
}

.setup-button {
  width: 48%;
}
