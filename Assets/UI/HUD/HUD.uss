.hud-root {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  flex-direction: row;
  justify-content: flex-end;
}

.right-band {
  width: 320px;
  justify-content: space-between;
  align-items: flex-end;
}

.panel {
  background-color: rgba(20, 16, 12, 0.75);
  border-width: 1px;
  border-color: rgb(150, 120, 70);
  padding: 6px 16px;
}

.turn-panel {
  flex-direction: row;
  align-items: center;
  align-self: stretch;
  justify-content: center;
  margin-left: 16px;
}

.unit-panel {
  align-self: stretch;
  align-items: center;
  margin-left: 16px;
}

.player-swatch {
  width: 16px;
  height: 16px;
  margin-right: 8px;
  border-width: 1px;
  border-color: rgb(150, 120, 70);
}

.turn-label {
  font-size: 22px;
  color: rgb(235, 220, 190);
  -unity-font-style: bold;
}

.unit-name {
  font-size: 20px;
  color: rgb(235, 220, 190);
  -unity-font-style: bold;
}

.unit-move {
  font-size: 18px;
  color: rgb(235, 220, 190);
}

.path-badges {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

.path-badge {
  position: absolute;
  width: 26px;
  height: 26px;
  border-radius: 13px;
  border-width: 2px;
  border-color: rgb(235, 220, 190);
  -unity-text-align: middle-center;
  font-size: 15px;
  -unity-font-style: bold;
}

.tile-info {
  position: absolute;
  padding: 6px 12px;
}

.tile-info-line {
  font-size: 16px;
  color: rgb(235, 220, 190);
}

.tile-info-title {
  font-size: 18px;
  -unity-font-style: bold;
}

.hidden {
  visibility: hidden;
}
