.hud-root {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  flex-direction: row;
  justify-content: flex-end;
}

.right-band {
  width: 320px;
  justify-content: space-between;
  align-items: flex-end;
}

.panel {
  background-color: rgba(20, 16, 12, 0.75);
  border-width: 1px;
  border-color: rgb(150, 120, 70);
  padding: 6px 16px;
}

.turn-panel {
  flex-direction: row;
  align-items: center;
  align-self: stretch;
  justify-content: center;
  margin-left: 16px;
}

.unit-panel {
  align-self: stretch;
  align-items: center;
  margin-left: 16px;
}

.player-swatch {
  width: 16px;
  height: 16px;
  margin-right: 8px;
  border-width: 1px;
  border-color: rgb(150, 120, 70);
}

.turn-label {
  font-size: 22px;
  color: rgb(235, 220, 190);
  -unity-font-style: bold;
}

.unit-name {
  font-size: 20px;
  color: rgb(235, 220, 190);
  -unity-font-style: bold;
}

.unit-move {
  font-size: 18px;
  color: rgb(235, 220, 190);
}

.path-badges {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

.path-badge {
  position: absolute;
  width: 26px;
  height: 26px;
  border-radius: 13px;
  border-width: 2px;
  border-color: rgb(235, 220, 190);
  -unity-text-align: middle-center;
  font-size: 15px;
  -unity-font-style: bold;
}

.tile-info {
  position: absolute;
  padding: 6px 12px;
}

.tile-info-line {
  font-size: 16px;
  color: rgb(235, 220, 190);
}

.tile-info-title {
  font-size: 18px;
  -unity-font-style: bold;
}

.hud-menu-button {
  position: absolute;
  left: 16px;
  top: 0;
  width: 140px;
  height: 40px;
  font-size: 20px;
}

.pause-veil {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  align-items: center;
  justify-content: center;
}

.debug-console {
  position: absolute;
  left: 16px;
  bottom: 16px;
  width: 680px;
  height: 340px;
}

.console-log {
  flex-grow: 1;
  margin: 6px 0;
}

.console-line {
  font-size: 14px;
  color: rgb(235, 220, 190);
  white-space: normal;
}

.console-input {
  font-size: 16px;
}

.loading-screen {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgb(28, 23, 18);
  align-items: center;
  justify-content: center;
}

.loading-label {
  font-size: 24px;
  color: rgb(235, 220, 190);
  margin: 24px 0 12px 0;
}

.loading-bar {
  width: 480px;
  height: 14px;
  border-width: 1px;
  border-color: rgb(150, 120, 70);
  background-color: rgb(45, 36, 27);
}

.loading-fill {
  height: 100%;
  width: 0;
  background-color: rgb(150, 120, 70);
}

.hidden {
  visibility: hidden;
}
