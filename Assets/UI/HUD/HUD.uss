.top-bar {
  flex-direction: row;
  padding: 6px 16px;
  background-color: rgba(20, 16, 12, 0.75);
  border-bottom-width: 1px;
  border-bottom-color: rgb(150, 120, 70);
}

.unit-label {
  flex-grow: 1;
  font-size: 20px;
  color: rgb(235, 220, 190);
}

.hidden {
  visibility: hidden;
}

.player-swatch {
  width: 16px;
  height: 16px;
  margin-right: 8px;
  align-self: center;
  border-width: 1px;
  border-color: rgb(150, 120, 70);
}

.turn-label {
  font-size: 22px;
  color: rgb(235, 220, 190);
  -unity-font-style: bold;
}
