<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:Template name="OptionsPanel" src="../Menu/OptionsPanel.uxml" />
  <ui:Style src="../Menu/MenuShared.uss" />
  <ui:Style src="HUD.uss" />
  <ui:VisualElement name="hudRoot" class="hud-root" picking-mode="Ignore">
    <ui:VisualElement name="rightBand" class="right-band" picking-mode="Ignore">
      <ui:VisualElement name="turnPanel" class="panel turn-panel" picking-mode="Ignore">
        <ui:VisualElement name="playerSwatch" class="player-swatch" picking-mode="Ignore" />
        <ui:Label name="turnLabel" class="turn-label" text="Tour 1" picking-mode="Ignore" />
      </ui:VisualElement>
      <ui:VisualElement name="unitPanel" class="panel unit-panel hidden" picking-mode="Ignore">
        <ui:Label name="unitNameLabel" class="unit-name" picking-mode="Ignore" />
        <ui:Label name="unitMoveLabel" class="unit-move" picking-mode="Ignore" />
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="pathBadges" class="path-badges" picking-mode="Ignore" />
    <ui:VisualElement name="tileInfo" class="panel tile-info hidden" picking-mode="Ignore" />
    <ui:Button name="menuButton" class="menu-button hud-menu-button" text="Menu" />
    <ui:VisualElement name="pauseMenu" class="pause-veil hidden">
      <ui:VisualElement name="pausePanel" class="menu-panel">
        <ui:Button name="resume" class="menu-button" text="Reprendre" />
        <ui:Button name="pauseOptions" class="menu-button" text="Options" />
        <ui:Button name="mainMenu" class="menu-button" text="Menu principal" />
        <ui:Button name="quitGame" class="menu-button" text="Quitter" />
      </ui:VisualElement>
      <ui:Instance template="OptionsPanel" name="optionsPanel" />
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
